{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"moduleResolution": "bundler",
		"module": "esnext",
		"target": "esnext",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"lib": ["esnext"],
		"types": ["bun"]
	}
}
