	(text "RP2350 Wireless Dev Board - block overview\n\nUSB-C (5V) -> BQ24074 charger/power-path -> VSYS -> TLV75733P LDO -> 3V3\n1-cell Li-Po on JST-PH (charged at 445 mA, VBAT/3 monitored on GPIO29)\nRP2350A + 16 MB QSPI flash + 8 MB QSPI PSRAM (GPIO8 = XIP_CS1)\nESP32-C6-MINI-1 (Wi-Fi 6 / BLE 5) on UART1 with RTS/CTS flow control\nmicroSD (SDIO 4-bit / SPI), Qwiic I2C0, WS2812B-2020 RGB LED, user LED\n"
		(exclude_from_sim no)
		(at 30 140 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "dc335c51-15bc-54bf-9366-c66f6a28cb39")
	)
	(text "GPIO map\nGP0/GP1  UART0 TX/RX (header)\nGP2-GP5  header\nGP6      ~PGOOD (USB power present, low)\nGP7      ~CHG (charging, low)\nGP8      PSRAM CS (XIP_CS1)\nGP9      microSD card detect\nGP10-15  microSD CLK, CMD, D0-D3\n"
		(exclude_from_sim no)
		(at 30 185 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "2df446f1-250c-5a8c-a11f-92f7385f43df")
	)
	(text "\nGP16/17  I2C0 SDA/SCL (Qwiic + header)\nGP18     ESP32-C6 EN\nGP19     ESP32-C6 IO9 (boot strap)\nGP20-23  UART1 TX/RX/CTS/RTS to ESP32-C6\nGP24     WS2812B data, GP25 user LED\nGP26-28  ADC0-2 (header)\nGP29     VBAT/3 (ADC3)\n"
		(exclude_from_sim no)
		(at 140 185 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "000334fc-27ea-50a1-ac5f-022090ffa1f1")
	)
