	(text "RP2350A core copied from Raspberry Pi 'RP2350A Minimal' R4 reference\n(MIT licence): regulator (L1 polarity-marked AOTA-B201610, C8/C9/C10,\nR12 33R), crystal (ABM8-272-T3, 15p, 1k), decoupling, flash, BOOTSEL.\nSchematic refs differ; PCB placement/routing of this block is the RPi\nlayout rotated 90 deg."
		(exclude_from_sim no)
		(at 110 222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e359f3c5-38a5-55a9-815c-7d2914f446a3")
	)
	(text "PSRAM (APS6404L, 8 MB) on XIP_CS1 = GPIO8 (same as Adafruit Feather\nRP2350 so existing board configs work). Flash 16 MB on QSPI_SS.\nBOOT button doubles as a user button (read via QSPI_SS).\nSWD on JST-SH 3 pin (Raspberry Pi Debug Probe pinout)."
		(exclude_from_sim no)
		(at 260 222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6f43dab4-b15a-5eea-b9bc-5bdd970d09c6")
	)
	(embedded_fonts no)
)
