	(text "microSD wired for 4-bit SDIO via PIO (CLK GPIO10, CMD GPIO11,\nD0-D3 GPIO12-15 consecutive) and also usable in SPI mode\n(SPI1: SCK=10, MOSI=11, MISO=12, CS=15). Card detect GPIO9 (low = card).\nQwiic/STEMMA QT on I2C0 GPIO16/17 with 4.7k pull-ups.\nWS2812B-2020 on GPIO24 (powered from 3V3). User LED GPIO25."
		(exclude_from_sim no)
		(at 110 222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "e3e2e92e-a207-5182-aeae-4c4a68b9fa48")
	)
	(text "Headers are 2.54 mm, fitted on the bottom side (breadboard use).\nJ6: VBUS VSYS VBAT GND 3V3 EN RUN GND A0 A1 A2 GND\nJ7: GP0(TX) GP1(RX) GP2 GP3 GP4 GP5 GND SDA SCL 3V3 GND GND"
		(exclude_from_sim no)
		(at 260 222 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "66f769a8-aa8c-5425-a0fe-4b77d5625348")
	)
	(embedded_fonts no)
)
