		(at 12.7 12.7 0)
		(effects
			(font
				(size 3 3)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ac09ebea-c697-4c06-9aa2-ca8beb931aca")
	)
	(text "USB-C sink: 5.1 kΩ Rd on CC1/CC2. BQ24074 EN1 = VSYS, EN2 = GND: USB500 input current limit."
		(exclude_from_sim no)
		(at 12.7 22.86 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "da7366fd-376c-400f-a2e3-9a477fa79fda")
	)
	(text "Charge LED runs from VBUS. Header VSYS and +3V3 are outputs only: VSYS connects straight to the cell."
