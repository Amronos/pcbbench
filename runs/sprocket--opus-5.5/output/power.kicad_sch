	(text "VBAT_SENSE = VBAT / 2 to GPIO28 (ADC2). VBUS_SENSE = 0.595 x VBUS to RM2 WL_GPIO2, as on Pico W."
		(exclude_from_sim no)
		(at 12.7 38.1 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "1c382bb2-fe88-4134-a28a-f3f4776cc265")
	)
	(text "Charge current = 890 AΩ / R4 = 330 mA. TS has a fixed 10 kΩ (no NTC). Default safety timers, 10 % termination."
		(exclude_from_sim no)
		(at 12.7 27.94 0)
		(effects
			(font
				(size 1.778 1.778)
			)
			(justify left top)
		)
		(uuid "9cfc2938-87a0-4788-9bfb-99df7a3669a8")
	)
	(text "Power: USB-C, LiPo charger with power path, 3.3 V LDO, sensing"
