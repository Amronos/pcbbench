(global_label "ESP_PROG_TX" (shape bidirectional) (at 148.5900 254.0000 270) (effects (font (size 0.9 0.9)) (justify right)) (uuid "4d410eb8-bd3b-5519-9086-c98a67f07196") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 148.5900 254.0000 270) (effects (font (size 1.0 1.0)) (hide yes))))(text "ESP-AT UART1: GPIO6 RX <- RP GP20; GPIO7 TX -> RP GP21.\nGPIO4 RTS -> RP GP22 CTS; GPIO5 CTS <- RP GP23 RTS.\nUART0 GPIO20/21 is a separate 3.3V programming interface; start115200baud." (at 25 20 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "266aa036-5ca1-5774-9617-3ff05fe2ed42"))
(text "Radio disabled by 10k EN pull-down at cold boot. Enable only after power budget is known.\nGP19 controls IO9 as open-drain: release for normal boot, pull low while pulsing EN for download.\nIO8 and IO2 strap high. Antenna projects beyond top PCB edge; do not enclose with metal." (at 25 211 0) (effects (font (size 1.2 1.2)) (justify left)) (uuid "4178cea1-9984-50ee-9857-a844f64c5026"))
