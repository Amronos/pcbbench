				(thickness 0.1855)
				(material "7628")
				(epsilon_r 4.74)
				(loss_tangent 0.02)
				(spec_frequency 1000000000)
				(dielectric_model constant)
			)
			(layer "B.Cu"
				(type "copper")
				(thickness 0.035)
			)
			(layer "B.Mask"
				(type "Bottom Solder Mask")
				(color "Green")
				(thickness 0.01)
			)
			(layer "B.Paste"
				(type "Bottom Solder Paste")
			)
			(layer "B.SilkS"
