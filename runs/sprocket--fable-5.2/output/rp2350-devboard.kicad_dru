(version 1)

# The core regulator copies Raspberry Pi's reference layout: VREG_LX runs between the pads of
# the 0402 capacitors C6 and C7, where the pad gap is 0.4 mm.
(rule "VREG_LX between capacitor pads"
	(condition "A.NetName == '/VREG_LX' || B.NetName == '/VREG_LX'")
	(constraint clearance (min 0.13mm))
	(constraint track_width (min 0.13mm)))

# GCT's USB4105 land pattern puts its locating pegs 0.19 mm from its own signal pads.
(rule "USB-C locating pegs"
	(condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
	(constraint hole_clearance (min 0.15mm)))
