---
import Base from '../../layouts/Base.astro';
import { points } from '../../data/format';
import { tasks } from '../../data/runs';
---

<Base title="Tasks · PCBBench" description="The boards PCBBench asks AI agents to design in KiCad.">
	<section class="page section">
		<h1>Tasks</h1>
		<p class="lede">Each task is one prompt for a board that a fab can build and assemble.</p>
		<ul class="tasks">
			{
				tasks.map((task) => {
					const [top] = task.runs;

					return (
						<li>
							<a href={`/tasks/${task.id}`}>
								<h2>{task.name}</h2>
							</a>
							<p>{task.summary}</p>
							<dl>
								<div>
									<dt>Runs</dt>
									<dd>{task.runs.length}</dd>
								</div>
								{top && (
									<div>
										<dt>Top score</dt>
										<dd>
											{points(top.metrics.score.total)}, {top.model.name} in {top.harness.name}
										</dd>
									</div>
								)}
							</dl>
						</li>
					);
				})
			}
		</ul>
	</section>
</Base>

<style>
	h1 {
		font-size: var(--step-3);
	}

	.tasks {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
	}

	.tasks li {
		display: grid;
		gap: 0.5rem;
		border-top: 1px solid var(--rule);
		padding-top: 1.25rem;
	}

	.tasks a {
		text-decoration: none;
		width: fit-content;
	}

	h2 {
		font-size: var(--step-2);
	}

	dl {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 2.5rem;
		margin: 0;
		font-size: var(--step--1);
	}

	dt {
		color: var(--dim);
	}

	dd {
		margin: 0;
	}
</style>
