---
import { Image } from 'astro:assets';
import type { ScaledRender } from '../data/runs';

type Props = {
	render: ScaledRender;
	widthMm: number;
	heightMm: number;
	alt: string;
	// The largest px per mm this board is drawn at, for picking image sizes.
	maxScale: number;
	loading?: 'eager' | 'lazy';
};

const { render, widthMm, heightMm, alt, maxScale, loading = 'lazy' } = Astro.props;
const imageMm = render.image.width / render.pxPerMm;
const displayPx = Math.round(imageMm * maxScale);
const { board } = render;
const pct = (value: number) => `${(value * 100).toFixed(3)}%`;
---

<figure class="scaled" style={`--image-mm: ${imageMm}`}>
	<Image
		src={render.image}
		alt={alt}
		widths={[displayPx, Math.min(displayPx * 2, render.image.width)]}
		sizes={`${displayPx}px`}
		loading={loading}
		fetchpriority={loading === 'eager' ? 'high' : 'auto'}
	/>
	<span
		class="dim across"
		style={`left: ${pct(board.x)}; width: ${pct(board.width)}; top: calc(${pct(board.y + board.height)} + 0.6rem)`}
		><span>{Number(widthMm.toFixed(2))}</span></span
	>
	<span
		class="dim down"
		style={`top: ${pct(board.y)}; height: ${pct(board.height)}; left: calc(${pct(board.x + board.width)} + 0.6rem)`}
		><span>{Number(heightMm.toFixed(2))}</span></span
	>
</figure>

<style>
	.scaled {
		position: relative;
		margin: 0 2.25rem 2.25rem 0;
		width: calc(var(--image-mm) * var(--scale) * 1px);
		max-width: calc(100% - 2.25rem);
	}

	.scaled :global(img) {
		width: 100%;
		filter: drop-shadow(0 0.6rem 1.2rem rgb(0 0 0 / 0.45));
	}

	/* Dimension lines, drawn the way a fab drawing marks the board outline in mm. */
	.dim {
		position: absolute;
		color: var(--dim);
		font-family: var(--font-iso);
		font-size: 0.8125rem;
		line-height: 1;
		pointer-events: none;
	}

	.dim::before,
	.dim::after {
		content: '';
		position: absolute;
		background: currentColor;
	}

	.across {
		height: 1px;
		background: currentColor;
	}

	.across::before,
	.across::after {
		width: 1px;
		height: 0.6rem;
		top: -0.3rem;
	}

	.across::before {
		left: 0;
	}

	.across::after {
		right: 0;
	}

	.across > span {
		position: absolute;
		left: 50%;
		top: 0.3rem;
		translate: -50% 0;
	}

	.down {
		width: 1px;
		background: currentColor;
	}

	.down::before,
	.down::after {
		height: 1px;
		width: 0.6rem;
		left: -0.3rem;
	}

	.down::before {
		top: 0;
	}

	.down::after {
		bottom: 0;
	}

	.down > span {
		position: absolute;
		top: 50%;
		left: 0.35rem;
		writing-mode: vertical-rl;
		translate: 0 -50%;
	}
</style>
