---
import { groupPoints, type Group } from '@pcbbench/bench/scoring';
import { points } from '../data/format';
import type { Run } from '../data/runs';
import { GROUP_LABELS } from '../data/scoring';

type Props = { run: Run; group: Group };

const { run, group } = Astro.props;
---

<h2 style={`--color: var(--${group})`}>
	{GROUP_LABELS[group]}{' '}
	<span class="of">{points(run.metrics.score.groups[group])} of {groupPoints(group)}</span>
</h2>

<style>
	h2::before {
		content: '';
		display: inline-block;
		width: 0.55em;
		height: 0.55em;
		margin-right: 0.4em;
		border-radius: 2px;
		background: var(--color);
		vertical-align: 0.1em;
	}

	.of {
		color: var(--dim);
		font-family: var(--font-body);
		font-size: var(--step-1);
	}
</style>
