---
import { MAJOR_COST, MINOR_COST, REVIEW_AREA_POINTS } from '@pcbbench/bench/scoring';
import { MODELS } from '../data/catalog';
import type { Run } from '../data/runs';

type Props = { run: Run };

const { run } = Astro.props;
const { findings, notes } = run.review;
const judge = MODELS[run.review.judge].name;

const SEVERITIES = [
	{ id: 'fatal', label: 'Fatal', cost: 'fails a gate' },
	{ id: 'major', label: 'Major', cost: `costs its area ${MAJOR_COST} points` },
	{ id: 'minor', label: 'Minor', cost: `costs its area ${MINOR_COST} point` }
] as const;

const AREAS = [
	{ id: 'layout', label: 'Layout' },
	{ id: 'routing', label: 'Routing' },
	{ id: 'other', label: 'Other' }
] as const;

const severities = SEVERITIES.flatMap((severity) => {
	const ofSeverity = findings.filter((finding) => finding.severity === severity.id);

	const areas = AREAS.flatMap((area) => {
		const inArea = ofSeverity.filter((finding) => finding.area === area.id);

		return inArea.length ? [{ ...area, findings: inArea }] : [];
	});

	return ofSeverity.length ? [{ ...severity, count: ofSeverity.length, areas }] : [];
});
---

<div class="review">
	<p class="lede">
		{judge} reviewed an anonymous copy of the board and listed {findings.length}{' '}
		{findings.length === 1 ? 'finding' : 'findings'}. Layout and routing each start at {
			REVIEW_AREA_POINTS
		} points.
	</p>

	{
		severities.map((severity) => (
			<section class:list={['severity', severity.id]}>
				<h3>
					{severity.label}{' '}
					<span class="meta">
						{severity.count} {severity.count === 1 ? 'finding' : 'findings'}, each {severity.cost}
					</span>
				</h3>
				{severity.areas.map((area) => (
					<div class="area">
						<h4>{area.label}</h4>
						<ol>
							{area.findings.map((finding) => (
								<li>
									<p>{finding.issue}</p>
									<p class="tags">
										{finding.refs.length > 0 && <span>Parts: {finding.refs.join(', ')}</span>}
										{finding.nets.length > 0 && <span>Nets: {finding.nets.join(', ')}</span>}
									</p>
									<details>
										<summary>Evidence</summary>
										<p>{finding.evidence}</p>
									</details>
								</li>
							))}
						</ol>
					</div>
				))}
			</section>
		))
	}

	<details class="notes">
		<summary>
			{judge}'s notes{' '}
			<span class="meta">
				Final message
				{
					notes.subagents.length > 0 &&
						` and ${notes.subagents.length} subagent ${notes.subagents.length === 1 ? 'report' : 'reports'}`
				}
			</span>
		</summary>
		<div class="prose" set:html={notes.final} />
		{
			notes.subagents.map((subagent, index) => (
				<details class="subagent">
					<summary>Subagent report {index + 1}</summary>
					<p class="task">Task: {subagent.task}</p>
					<div class="prose" set:html={subagent.report} />
				</details>
			))
		}
	</details>
</div>

<style>
	.review {
		display: grid;
		gap: 2rem;
	}

	.severity {
		display: grid;
		gap: 1rem;
		border-left: 3px solid var(--color);
		padding-left: 1rem;
	}

	.fatal {
		--color: var(--fail);
	}

	.major {
		--color: var(--warn);
	}

	.minor {
		--color: var(--rule);
	}

	h3 {
		font-size: var(--step-1);
	}

	.meta {
		font-family: var(--font-body);
		font-size: var(--step--1);
		color: var(--dim);
	}

	h4 {
		margin: 0 0 0.5rem;
		font-size: var(--step-0);
		font-weight: 600;
	}

	ol {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 1rem;
		max-width: var(--measure);
	}

	li {
		display: grid;
		gap: 0.25rem;
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.5rem;
		font-size: var(--step--1);
		color: var(--dim);
	}

	.tags:empty {
		display: none;
	}

	details summary {
		cursor: pointer;
		width: fit-content;
	}

	li details {
		font-size: var(--step--1);
	}

	li details summary {
		color: var(--dim);
	}

	li details p {
		margin-top: 0.25rem;
		color: var(--dim);
	}

	.notes {
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}

	.notes > summary {
		padding: 0.9rem 0;
		font-family: var(--font-iso);
		font-size: var(--step-1);
	}

	.notes > .prose {
		padding-bottom: 1.5rem;
	}

	.subagent {
		border-top: 1px solid var(--rule);
		padding: 0.75rem 0;
	}

	.subagent .prose,
	.task {
		margin-top: 0.75rem;
	}

	.task {
		font-size: var(--step--1);
		color: var(--dim);
	}
</style>
